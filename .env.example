# ==============================================================================
# VeriAI Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Path (defaults to SQLite in project root)
DATABASE_URL=sqlite:///hallucination_verification.db

# LLM Provider API Keys (Optional - offline heuristics will be used if omitted)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Model & Verification Settings
DEFAULT_MODEL=hybrid-verifier-v1
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT_SECONDS=15
ENABLE_CRITIC_PASS=true
